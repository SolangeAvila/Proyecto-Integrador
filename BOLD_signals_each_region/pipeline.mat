ylabel(ax1, 'Sujetos (1-68)', 'FontSize', 10);
zlabel(ax1, 'Valor Medio', 'FontSize', 10);
title(ax1, 'Medias Temporales 3D', 'FontSize', 12);
view(30, 30);
grid on;

% Mapa de calor 2D
