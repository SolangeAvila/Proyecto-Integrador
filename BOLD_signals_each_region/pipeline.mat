function width = fwhm_autocorr(acorr, lags)
    % usa solo lags >= 0
    ac = acorr(lags >= 0);
    lg = lags(lags >= 0);

    % valor máximo (en autocorrelación siempre está en lag=0)
    [peak_val, peak_idx] = max(ac);

    halfmax = peak_val / 2;

    % diferencias con el valor mitad
    diff_ac = ac - halfmax;

    % buscar puntos donde cruza la mitad
    idx = find(diff_ac < 0, 1);  % primer cruce hacia abajo

    % si nunca baja → asignar ancho máximo posible
    if isempty(idx)
        width = lg(end) - lg(1);
        return
    end

    % interpolación lineal con el punto anterior
    x1 = lg(idx-1); x2 = lg(idx);
    y1 = diff_ac(idx-1); y2 = diff_ac(idx);

    % intersección con half-maximum
    width = x1 - y1 * (x2 - x1) / (y2 - y1);
end
