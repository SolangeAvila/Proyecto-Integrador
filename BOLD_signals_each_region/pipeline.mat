%Descarto los sujetos que no aparecen en el listado de los datos: 21, 29, 56


num_sujetos = 68;
num_regiones = 80;
max_lag = 50; % Máximo retardo para calcular autocorrelación
num_bins = 209;
matrix_todo = zeros(num_sujetos,num_bins,num_regiones);

m = zeros(num_sujetos, num_regiones);      % Matriz para almacenar medias
vari = zeros(num_sujetos, num_regiones);   % Matriz para almacenar variabilidades
autocorrs = zeros(max_lag*2+1, num_regiones, num_sujetos); % Matriz para almacenar autocorrelaciones
fwhm = zeros(num_regiones, num_sujetos); % Ancho a media altura (FWHM)

for i = 1:71
    
    if i < 21 

        % Formatea el número con 3 dígitos
        num_str = sprintf('%03d', i);  
        % Construye el nombre del archivo
        nombre_archivo = ['ROISignals_Sub_', num_str, '.mat'];
            
        % Carga el archivo .mat
        datos_cargados = load(nombre_archivo);   
        A = datos_cargados.ROISignals;
        matrix_todo(i,:,:) = A;     
    
        % Cálculos estadísticos
        media_temporal = mean(A, 1);      % Media por columnas (regiones)
        varianza_temporal = var(detrend(A), 0, 1); % Varianza muestral por columnas
          
        % Almacena resultados
        m(i, :) = media_temporal;
        %vari(i, :) = sqrt(varianza_temporal)./media_temporal;
        vari(i,:) = sqrt(varianza_temporal);

        for region = 1:num_regiones
            % Serie temporal para esta región
            serie_temporal = detrend(A(:, region)); 
            
            [autocorr, lags] = xcorr(serie_temporal - mean(serie_temporal), max_lag, 'coeff');
            autocorrs(:, region, i) = autocorr;
            
            fwhm(region, i) = fwhm_autocorr(autocorr, lags);
       end
        
        % Limpia la variable A para la siguiente iteración
        clear A;
    end

    if i> 21 && i < 29

        num_str = sprintf('%03d', i);  
        nombre_archivo = ['ROISignals_Sub_', num_str, '.mat'];

        datos_cargados = load(nombre_archivo);   
        A = datos_cargados.ROISignals;

        media_temporal = mean(A, 1);      % Media por columnas (regiones)
        varianza_temporal = var(detrend(A), 0, 1); % Varianza muestral por columnas
        m(i-1, :) = media_temporal;
        vari(i-1, :) = sqrt(varianza_temporal);

        for region = 1:num_regiones
            serie_temporal = detrend(A(:, region)); 

            [autocorr, lags] = xcorr(serie_temporal - mean(serie_temporal), max_lag, 'coeff');
            autocorrs(:, region, i-1) = autocorr;

            fwhm(region, i-1) = fwhm_autocorr(autocorr, lags);
       end

         % Limpio la variable A para la siguiente iteración
         clear A;

    end

    if i > 29 && i < 56

        num_str = sprintf('%03d', i);  
        nombre_archivo = ['ROISignals_Sub_', num_str, '.mat'];

        datos_cargados = load(nombre_archivo);   
        A = datos_cargados.ROISignals;


        media_temporal = mean(A, 1);      % Media por columnas (regiones)
        varianza_temporal = var(detrend(A), 0, 1); % Varianza muestral por columnas

        m(i-2, :) = media_temporal;
        vari(i-2, :) = sqrt(varianza_temporal);

        for region = 1:num_regiones
            serie_temporal = detrend(A(:, region)); 

            [autocorr, lags] = xcorr(serie_temporal - mean(serie_temporal), max_lag, 'coeff');
            autocorrs(:, region, i-2) = autocorr;

            fwhm(region, i-2) = fwhm_autocorr(autocorr, lags);

       end


         % Limpia la variable A para la siguiente iteración
        clear A;

    end

    if i > 56

        num_str = sprintf('%03d', i);  
        nombre_archivo = ['ROISignals_Sub_', num_str, '.mat'];

        datos_cargados = load(nombre_archivo);   
        A = datos_cargados.ROISignals;


        media_temporal = mean(A, 1);      % Media por columnas (regiones)
        varianza_temporal = var(detrend(A), 0, 1); % Varianza muestral por columnas

        % Almacena resultados
        m(i-3, :) = media_temporal;
        vari(i-3, :) = sqrt(varianza_temporal);

        for region = 1:num_regiones
            % Serie temporal para esta región
            serie_temporal = detrend(A(:, region)); 

            [autocorr, lags] = xcorr(serie_temporal - mean(serie_temporal), max_lag, 'coeff');
            autocorrs(:, region, i-3) = autocorr;

            fwhm(region, i-3) = fwhm_autocorr(autocorr, lags);

       end


        clear A;

    end
end


nombre_hdf5 = 'matrix_todo.h5';
if exist(nombre_hdf5, 'file')
    delete(nombre_hdf5);
end

h5create(nombre_hdf5, '/matrix_todo', size(matrix_todo));

h5write(nombre_hdf5, '/matrix_todo', matrix_todo);

disp('Guardado');


%% ANALISIS DE SUJETOS

%MEDIAS

