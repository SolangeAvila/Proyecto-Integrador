ylabel(ax2, 'Sujetos', 'FontSize', 10);
title(ax2, 'Mapa de Calor 2D', 'FontSize', 12);

colormap(ax2, flipud(pink)); % Pink invertido da buenos colores pastel
cbar2 = colorbar(ax2);
cbar2.Label.String = 'Valor Medio';
title('Mapa de Calor (alto contraste)');

% Ajuste final
brighten(0.1); % Aclarar ligeramente todos los colores


